# Copy to .env.local (or .env) and fill in for anything other than local dev against
# a Backend on its default port. Vite inlines these at build time - changing them means
# rebuilding, not just restarting a server.

VITE_ADMIN_API_URL=http://localhost:4000/api

# Only used to build "preview on storefront" links from the homepage/content editors.
VITE_STOREFRONT_URL=http://localhost:5173
