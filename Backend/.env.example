# Copy to .env and fill in. config/env.js parses this with zod at boot and
# throws on anything missing or malformed, so a typo fails loudly on startup
# rather than as a confusing 500 three screens later.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres. The test database must be a SEPARATE database - the vitest suite
# truncates every table between suites.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pure_aura
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/pure_aura_test

# Two separate secrets on purpose: a customer token presented to an admin route
# must fail at the signature, not at a role check. Two independent gates.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ADMIN_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_ADMIN_ACCESS_TTL=30m
JWT_REFRESH_TTL_DAYS=30

# CORS allowlist. Both apps send credentials, so these must be exact origins.
STOREFRONT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
COOKIE_DOMAIN=
COOKIE_SECURE=false

# local | s3. Switching to s3 requires every S3_* var below; index.js throws at
# boot if any is missing rather than silently falling back to local disk.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/media

# Only read when STORAGE_DRIVER=s3. No CloudFront - MEDIA_PUBLIC_BASE_URL points
# straight at the bucket, e.g. https://pure-aura.s3.ap-south-1.amazonaws.com
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Seed admin. If the password is omitted the seed prints a generated one once.
SEED_ADMIN_EMAIL=admin@pureaura.test
SEED_ADMIN_PASSWORD=

# Transactional email (order confirmation/shipped, payment verified, password reset).
# If unset outside production, a disposable Ethereal test inbox is created on first
# send and its preview URL is logged - nothing real is delivered. Required in production.
SMTP_URL=
MAIL_FROM=Pure Aura <no-reply@pureaura.test>
